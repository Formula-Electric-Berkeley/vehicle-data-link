{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "PostgreSQL Data Source",
  "id": "feb-postgresql-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_postgresql_datasource",
  "info": {
    "description": "Data source plugin for querying PostgreSQL databases",
    "author": {
      "name": "Feb"
    },
    "keywords": ["datasource", "postgresql", "sql"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "Website",
        "url": "https://github.com/feb/postgresql-datasource"
      },
      {
        "name": "License",
        "url": "https://github.com/feb/postgresql-datasource/blob/main/LICENSE"
      }
    ],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": []
  },
  "routes": [
    {
      "path": "query",
      "method": "POST",
      "url": "http://localhost:5432",
      "body": {
        "query": "{{ .Query }}",
        "parameters": "{{ .Parameters }}"
      }
    }
  ]
}